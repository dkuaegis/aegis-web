{
  "name": "aegis-web",
  "private": true,
  "license": "MIT",
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@12.17.0",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router typegen && tsc -b && react-router build",
    "check": "biome check --write .",
    "check:ci": "biome check .",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "preview": "vite preview --outDir build/client",
    "typecheck": "react-router typegen && tsc -b",
    "i18n:check": "node scripts/check-i18n.mjs",
    "knip": "react-router typegen && knip",
    "api:fetch": "node scripts/fetch-openapi.mjs",
    "api:generate": "orval && biome format --write app/api/generated"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@fontsource/stack-sans-notch": "^5.3.0",
    "@hookform/resolvers": "^6.0.2",
    "@react-router/node": "^8.5.1",
    "@react-three/fiber": "^9.8.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "isbot": "^5.2.2",
    "lucide-react": "^1.64.0",
    "pretendard": "^1.3.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-router": "^8.5.1",
    "tailwind-merge": "^3.7.0",
    "three": "^0.187.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@react-router/dev": "8.5.1",
    "@tailwindcss/vite": "4.3.4",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "knip": "6.44.1",
    "orval": "8.46.0",
    "tailwindcss": "4.3.4",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
